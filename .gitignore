# Local environments
.venv*/
__pycache__/
*.py[cod]

# Hugging Face and other caches, model weights, datasets (not redistributed; see LICENSE_NOTES.md)
.cache/
cache/
models/
data/
# Narrow exception: the companion's two generated JSON files (derived numbers only, no dataset
# text) must be tracked so GitHub Pages and CI see them. Re-include the directory, ignore
# everything else in it, then re-include exactly these two files.
!/docs/site/data/
/docs/site/data/*
!/docs/site/data/companion.json
!/docs/site/data/unpack_cases.json
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf

# Pilot checkpoints: derivatives of the model weights, local only
results/quality-pilot/checkpoints/

# Frozen window token ids decode to WikiText text; only their hashes are published (manifest.json)
results/quality-pilot/windows.json

# Upstream checkout (CC BY-NC 4.0); anyone reproducing needs their own copy
upstream/

# Private handoff evidence: assistant session transcripts and prompts
evidence/claude-*.json
evidence/report-prompt.txt

# Container output scratch
results-container/

# OS noise
.DS_Store
